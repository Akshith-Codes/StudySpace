PORT=5000
NODE_ENV=development
MONGO_URI=mongodb://127.0.0.1:27017/studyspace_ai
JWT_SECRET=change_this_to_a_long_random_secret
JWT_EXPIRES_IN=7d
CLIENT_URL=http://localhost:5173

# No-show processor interval (cron expression, default every minute)
NO_SHOW_CRON=* * * * *

# Check-in window in minutes (how long after start time a student can still check in)
CHECKIN_WINDOW_MINUTES=5

# Waitlist claim window in minutes
WAITLIST_CLAIM_WINDOW_MINUTES=10

# Occupancy thresholds (percentages)
OCCUPANCY_MODERATE_THRESHOLD=50
OCCUPANCY_CROWDED_THRESHOLD=75
OCCUPANCY_FULL_THRESHOLD=90
